# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/app/generated/prisma

# local storage (passwords + uploaded photos = user data, not for git)
/storage/config.json
/storage/attachments/
/storage/references/

# config 데이터 스냅샷 (사업 데이터 — git 제외, 서버엔 별도 전달)
config-export.json

# scratch/migration helper scripts & backups (not for deploy)
/_*.mjs
/_backup_vw_*.json

# AI 도구 부산물 (앱 아님 — 로그/상태)
/.omo/
/.omx/
/.claude/

# 임시 파일 / 벤더 바이너리 (배포·저장소 대상 아님)
/tmp/

# 사내 ERP 문서 (기밀 — 저장소 제외, 로컬에만 유지)
/ERP Spec & Diagram/
/erp query/

# 실제 사업 데이터 (고객사·파트넘버·공차 — 기밀). 저장소엔 익명 데모 seed만 포함.
/prisma/seed.real.ts
/scripts/import-error-proof.ts
/scripts/import-sop-templates.ts
/scripts/import-vw-machine.ts
/scripts/inspect-excel.ts
/scripts/link-grease-template.ts
