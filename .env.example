# ─────────────────────────────────────────────────────────────
# QC Checklist — environment variables
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored and must NOT be committed.
# ─────────────────────────────────────────────────────────────

# [REQUIRED] SQL Server connection string (Prisma).
#   Windows (integrated) auth:
DATABASE_URL="sqlserver://HOSTNAME;database=qc_checklist;integratedSecurity=true;trustServerCertificate=true"
#   SQL login auth (alternative):
# DATABASE_URL="sqlserver://HOSTNAME;database=qc_checklist;user=USER;password=PASS;trustServerCertificate=true"

# [REQUIRED in production] Node environment. Use "production" on the server.
NODE_ENV="production"

# [REQUIRED for scheduled email] Bearer token the daily/shift report endpoint checks.
#   Generate a long random string. The Windows Task Scheduler call must send:
#     Authorization: Bearer <CRON_TOKEN>
CRON_TOKEN="change-me-to-a-long-random-string"

# [OPTIONAL] Base URL used for links in Slack OOR alerts (e.g. https://qc.factory.local:3443).
#   If unset, the app infers it from request headers.
# APP_BASE_URL="https://qc.factory.local:3443"

# [OPTIONAL] Force "secure" auth cookies. Auto-set to true when running via server.js (HTTPS).
#   Leave unset for plain HTTP (npm start).
# COOKIE_SECURE="true"

# ─────────────────────────────────────────────────────────────
# HTTPS server (server.js) — only when using `npm run start:https`
# ─────────────────────────────────────────────────────────────
# HTTPS_PORT="3443"
# HTTPS_HOST="0.0.0.0"
# SSL_KEY="./certs/server-key.pem"
# SSL_CERT="./certs/server-cert.pem"

# NOTE: SMTP email settings (host/user/password/recipients) are NOT here —
#       they are configured in the Admin → Notifications page and stored in
#       storage/config.json (along with hashed app/admin passwords).
